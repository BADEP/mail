<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="mail_tracking.FailedMessage">
        <div class="card mb-2">
            <div class="card-body py-2">
                <div class="o-mail-Activity d-flex px-3 py-1 mb-2">
                    <div
                        class="o-mail-Activity-sidebar flex-shrink-0 position-relative"
                    >
                        <img
                            class="o-mail-Message-avatar w-100 h-100 rounded"
                            t-att-class="this.authorAvatarAttClass"
                            t-att-src="this.authorAvatarUrl"
                            t-on-click.stop.prevent="this.onClickAvatar"
                        />
                        <div
                            class="o-mail-Activity-iconContainer position-absolute top-100 start-100 translate-middle d-flex align-items-center justify-content-center mt-n1 ms-n1 rounded-circle w-50 h-50 bg-danger text-light"
                        >
                            <i class="fa small fa-exclamation" />
                        </div>
                    </div>
                    <div class="flex-grow px-3">
                        <div class="o-mail-Activity-info lh-1">
                            <span
                                t-if="this.message.author or this.message.email_from"
                                class="o-mail-Message-author"
                                t-on-click.stop.prevent="this.onClickAvatar"
                                t-att-role="this.hasAuthorClickable() ? 'button' : ''"
                            >
                                <strong class="me-1 text-truncate">
                                    <t
                                        t-if="this.message.author"
                                        t-out="this.message.author.name"
                                    />
                                    <t t-else="" t-out="this.message.email_from" />
                                </strong>
                            </span>
                            <small
                                t-if="!this.message.is_transient"
                                class="o-mail-Message-date text-muted opacity-75"
                                t-att-class="{ 'me-2': !this.isAlignedRight }"
                                t-att-title="this.message.datetimeShort"
                            >
                            - <RelativeTime datetime="this.message.datetime" />
                        </small>
                            <i
                                class="fa fa-info-circle btn-link btn-primary cursor-pointer ms-1"
                                role="img"
                                title="Info"
                                aria-label="Info"
                                t-on-click="this.toggleDetails"
                            />
                        </div>
                        <div class="lh-lg">
                            <FailedMessageReview message="this.message" />
                            <span>
                                <a
                                    href="#"
                                    class="btn btn-link btn-success text-muted p-0 me-3"
                                    role="button"
                                    t-on-click="this.onClickJump"
                                >
                                <i
                                    class="fa fa-angle-double-down"
                                    role="img"
                                    aria-label="Go"
                                />
                                Go to message
                            </a>
                            </span>
                        </div>
                        <div class="o-mail-Activity-info lh-1">
                            <strong class="text-danger">Failed Recipients: </strong>
                            <MessageTracking
                                partner_trackings="this.failed_recipients"
                                message="this.message"
                                skip_track_links="true"
                            />
                        </div>
                        <div
                            t-if="this.state.showDetails"
                            class="position-relative text-break o-mail-Message-body p-1"
                        >
                            <em
                                t-if="this.message.subject and !this.message.isSubjectSimilarToOriginThreadName and !this.message.isSubjectDefault"
                                class="mb-1 me-2"
                            >Subject: <t t-out="this.message.subject" /></em>
                            <t t-if="this.message.body" t-out="this.message.body" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
